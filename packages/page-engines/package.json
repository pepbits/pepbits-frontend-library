{
  "name": "@pepbits/page-engines",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "pepbits-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./record-page": {
      "pepbits-source": "./src/record-page/index.tsx",
      "types": "./dist/record-page/index.d.ts",
      "import": "./dist/record-page/index.js",
      "default": "./dist/record-page/index.js"
    },
    "./record-layout": {
      "pepbits-source": "./src/record-layout/index.tsx",
      "types": "./dist/record-layout/index.d.ts",
      "import": "./dist/record-layout/index.js",
      "default": "./dist/record-layout/index.js"
    },
    "./types": {
      "pepbits-source": "./src/types/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./worklist": {
      "pepbits-source": "./src/worklist/index.ts",
      "types": "./dist/worklist/index.d.ts",
      "import": "./dist/worklist/index.js",
      "default": "./dist/worklist/index.js"
    },
    "./records": {
      "pepbits-source": "./src/records/index.ts",
      "types": "./dist/records/index.d.ts",
      "import": "./dist/records/index.js",
      "default": "./dist/records/index.js"
    },
    "./forms": {
      "pepbits-source": "./src/forms/index.ts",
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js",
      "default": "./dist/forms/index.js"
    },
    "./templates": {
      "pepbits-source": "./src/templates/index.ts",
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js",
      "default": "./dist/templates/index.js"
    },
    "./template-state": {
      "pepbits-source": "./src/templates/template-state.ts",
      "types": "./dist/templates/template-state.d.ts",
      "import": "./dist/templates/template-state.js",
      "default": "./dist/templates/template-state.js"
    },
    "./renderer": {
      "pepbits-source": "./src/renderer/index.tsx",
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js",
      "default": "./dist/renderer/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "node ../../tooling/scripts/build-package.mjs"
  },
  "devDependencies": {
    "@pepbits/tsconfig": "0.0.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@pepbits/i18n": "^0.1.0",
    "@pepbits/preferences": "^0.1.0",
    "@pepbits/ui": "^0.1.0",
    "@pepbits/components": "^0.1.0",
    "@pepbits/data": "^0.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@pepbits/platform": "^0.1.0",
    "@pepbits/patterns": "^0.1.0",
    "@pepbits/icons": "^0.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepbits/pepbits-frontend-library.git",
    "directory": "packages/page-engines"
  },
  "license": "UNLICENSED"
}
