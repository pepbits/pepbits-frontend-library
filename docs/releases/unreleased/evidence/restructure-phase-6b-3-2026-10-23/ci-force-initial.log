@pepbits-demo/showcase:test: import {createMemoryRecordAdapter,type RecordPanels,type RecordPanelsAdapter} from '@pepbits/data';
@pepbits-demo/showcase:test: import {RecordAdapterProvider,RecordPanelsPanel} from '@pepbits/page-engines/records';
@pepbits-demo/showcase:test: export function PanelsDemo(){const host=useMemo(()=>{const records=createMemoryRecordAdapter(),files=new Map<string,{name:string;content:string}>();const key=JSON.stringify(['showcase','panels']);const initial:RecordPanels={attachments:[],comments:[],related:[],activity:[],permissions:{write:true}};const adapter:RecordPanelsAdapter={load:async()=> (await records.load<RecordPanels>(key)).record?.values??structuredClone(initial),change:async(_scope,change,id)=>{const bundle=await records.load<RecordPanels>(key),data=bundle.record?.values??structuredClone(initial),item={id,authorId:'demo-editor',author:'Fictional editor',createdAt:new Date().toISOString()};if(change.action==='comment')data.comments.push({...item,text:change.text});if(change.action==='link')data.related.push({...item,pageId:change.pageId,recordId:change.recordId,label:change.label});if(change.action==='upload'){files.set(id,{name:change.name,content:change.content});data.attachments.push({...item,name:change.name,size:change.content.length});}if(change.action==='remove')data[change.collection]=data[change.collection].filter(item=>item.id!==change.id) as never;data.activity.push({...item,detail:`Fictional ${change.action}`});return (await records.save(key,data,bundle.record?.version??0,bundle.draftVersion,id)).record!.values;},download:async(_scope,id)=>{const file=files.get(id);if(!file)throw new Error('Fictional file unavailable');return file;}};return {records,adapter};},[]);return <RecordAdapterProvider value={{adapter:host.records,applicationId:'showcase',identity:'fictional-gallery:showcase:demo-editor',sessionAvailable:true}}><RecordPanelsPanel pageId=\"items\" recordId=\"ITEM-001\" adapter={host.adapter} actorId=\"demo-editor\" pages={[{id:'items',title:'Items'}]}/></RecordAdapterProvider>;}
