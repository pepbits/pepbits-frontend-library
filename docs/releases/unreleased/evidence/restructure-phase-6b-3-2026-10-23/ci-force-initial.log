@pepbits-demo/showcase:test:  <Select label=\"State select\" options={options} value={value} onChange={event=>{if(!blocked)setValue(event.target.value);}} disabled={blocked} error={error}/><SearchSelect label=\"State search choice\" options={options} value={value} onChange={next=>{if(!blocked)setValue(next);}} disabled={blocked} error={error}/><MultiSelect label=\"State multiple choices\" options={options} value={many} onChange={next=>{if(!blocked)setMany(next);}} disabled={blocked} error={error}/>
