@pepbits-demo/showcase:test: export function createDemoIdentity():IdentityAdapter{
@pepbits-demo/showcase:test:  const library:IdentityLibrary={devices:[{id:'reader',title:'Fictional reader',method:'card',transport:'native'}],subjects:[{id:'subject-a',name:'Fictional subject',birthDate:'2000-01-01'}],scenarios:[{id:'match',title:'Illustrative match'}],policy:{version:1,biometricsEnabled:false,lockedDevice:''},attempts:[],defaultDevice:'reader',canManage:false};
@pepbits-demo/showcase:test:  const operations=new Map<string,unknown>();
@pepbits-demo/showcase:test:  const adapter:IdentityAdapter={library:async()=>structuredClone(library),async command<T>(input:IdentityCommand):Promise<T>{
@pepbits-demo/showcase:test:   if(input.operationId&&operations.has(input.operationId))return structuredClone(operations.get(input.operationId)) as T;
@pepbits-demo/showcase:test:   let result:unknown=library;
@pepbits-demo/showcase:test:   if(input.action==='start'||input.action==='manual'){
@pepbits-demo/showcase:test:    const attempt:IdentityAttempt={id:input.operationId!,subjectId:input.subjectId??'subject-a',deviceId:input.deviceId??'reader',stationId:input.stationId,status:input.action==='manual'?'manual-review':'pending',authenticated:false,createdAt:new Date().toISOString(),expiresAt:new Date(Date.now()+120000).toISOString()};library.attempts.push(attempt);result=attempt;
@pepbits-demo/showcase:test:   }else if(input.action==='cancel'||input.action==='simulate'){const attempt=library.attempts.find(a=>a.id===input.attemptId)!;attempt.status=input.action==='cancel'?'cancelled':'demo-match';result=attempt;}
@pepbits-demo/showcase:test:   else if(input.action==='preference')library.defaultDevice=input.deviceId??'reader';
@pepbits-demo/showcase:test:   if(input.operationId)operations.set(input.operationId,structuredClone(result));return structuredClone(result) as T;
@pepbits-demo/showcase:test:  }};
@pepbits-demo/showcase:test:  return withIdentityConnector(adapter,{connector:createIdentityDeviceConnector(async ticket=>({challengeId:ticket.challengeId,status:'captured',assertionReference:'fictional-assertion'})),ticket:async attempt=>({challengeId:attempt.id,subjectReference:attempt.subjectId,deviceId:attempt.deviceId,method:'card',expiresAt:attempt.expiresAt}),verify:async attempt=>{const result={...attempt,status:'manual-review' as const};library.attempts=library.attempts.map(a=>a.id===result.id?result:a);return result;}});
@pepbits-demo/showcase:test: }
