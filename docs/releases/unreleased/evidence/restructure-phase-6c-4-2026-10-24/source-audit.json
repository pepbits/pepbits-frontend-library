  "findings": {
    "savedViews": "Source WorkList explicitly saves/applies {name,q,quick,filters} at keystone.views.<slug>; up to 30 views and 20,000 characters. Columns are hidden keys at keystone.cols.<slug>; source sort is mounted. Resumed 6c-4 adapts this contract and adds snapshot criteria/column-order/sort metadata, accepted by the bounded API object shape.",
    "reports": "ReportTemplate composes WorkList with grouping/totals; advanced fields are flagged filters, dates, numeric or boolean, excluding code/textarea. No independent pivot/compare-period controls.",
    "durableDrafts": "Read-only scan of all three source package TS/TSX files finds useStoredState only for columns, saved views and profile mode; no localStorage/sessionStorage form persistence. ERP2 useUnsavedGuard only attaches beforeunload. /drafts requires import/approval/dcp, original navigation IDs and strict payload keys. 6c-4 ports the warning; durable recovery remains unavailable.",
    "documents": "Support provides metadata only. Source LocalAttachments selects names/sizes on this screen without uploading."
  },
  "auditedAt": "2026-10-24T03:29:49.529225+00:00",
  "mountedCaseDraftPreservation": {
    "scope": "Both case entities in ERP1 and ERP2.",
    "finding": "Source comments stay mounted across property acknowledgements. Case view identity now excludes version; acknowledged saves update row state in place and preserve unrelated reply/assignee input. Navigation and explicit reload still remount the editor.",
    "verification": "53 focused record-panel tests passed, including two variant regressions; the final 70-workflow HTTP run passed version-acknowledged preservation assertions for both case entities in both variants."
  }
