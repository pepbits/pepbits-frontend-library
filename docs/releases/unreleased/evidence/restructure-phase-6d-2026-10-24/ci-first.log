@pepbits-demo/showcase:test: export function createDemoDesigner():DesignerAdapter{
@pepbits-demo/showcase:test:  const definition:DesignerDefinition={title:'Fictional item form',sections:[{id:'details',title:'Details',fields:[{id:'name',label:'Item name',type:'text',required:true},{id:'quantity',label:'Quantity',type:'number',min:0}]}]};
@pepbits-demo/showcase:test:  let view:DesignerView={initial:definition,canDesign:true,types:['text','number','select','checkbox','date'],records:[],record:null,catalog:{sets:[],relationships:[]}};
@pepbits-demo/showcase:test:  const operations=new Map<string,DesignerView>();
@pepbits-demo/showcase:test:  return {async command(command){
@pepbits-demo/showcase:test:   if(command.operationId&&operations.has(command.operationId))return structuredClone(operations.get(command.operationId)!);
@pepbits-demo/showcase:test:   if(command.action==='load')return structuredClone({...view,initial:view.record?.definition??definition});
@pepbits-demo/showcase:test:   if(command.action==='options')return {...structuredClone(view),lookup:designerOptions(command.definition??definition,command.fieldId??'',command.values??{})};
@pepbits-demo/showcase:test:   if(command.action==='validate')return {...structuredClone(view),validation:previewErrors(command.definition??definition,command.values??{})};
@pepbits-demo/showcase:test:   if(command.action!=='save')throw new WorkflowRequestFailure(403,{form:'This local example supports draft save and preview only.'});
@pepbits-demo/showcase:test:   if((command.revision??0)!==(view.record?.revision??0))throw new WorkflowRequestFailure(409,{form:'designer.conflict'});
@pepbits-demo/showcase:test:   const record={id:'example-form',revision:(view.record?.revision??0)+1,definition:structuredClone(command.definition!),updatedAt:new Date().toISOString()};
@pepbits-demo/showcase:test:   view={...view,initial:record.definition,record,records:[record]};
@pepbits-demo/showcase:test:   if(command.operationId)operations.set(command.operationId,structuredClone(view));return structuredClone(view);
@pepbits-demo/showcase:test:  }};
@pepbits-demo/showcase:test: }
