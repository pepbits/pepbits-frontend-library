@pepbits-demo/showcase:test: export function DraftCenterDemo(){const [revision,setRevision]=useState(0);const ports=useMemo(()=>{const drafts=createMemoryDraftAdapter();const scope={productId:'showcase',pageId:'items',recordId:'ITEM-001',kind:'dcp' as const};const ready=drafts.save(scope,{schemaVersion:1,context:'item-v1',data:{name:'Fictional draft'}},0,'seed');const item:DraftCenterItem={id:'a'.repeat(64),productId:'showcase',kind:'dcp',version:1,savedAt:new Date().toISOString(),expiresAt:new Date(Date.now()+7*86400000).toISOString(),status:'ready',pageId:'items',recordId:'ITEM-001'};const center:DraftCenterAdapter={list:async(_product,query)=>{await ready;const bundle=await drafts.load(scope),items=bundle.draft&&(!query.query||'ITEM-001'.includes(query.query))&&(!query.kind||query.kind==='dcp')&&(!query.status||query.status==='ready')?[item]:[];return {items,total:items.length,offset:0,policy:bundle.draftPolicy,counts:{all:items.length,outdated:0,unavailable:0},serverTime:new Date().toISOString()};},open:async()=>{await ready;return item;},discard:async(_product,_item,id)=>{const bundle=await drafts.load(scope);await drafts.discard(scope,bundle.draftVersion,id);}};return {drafts,center};},[revision]);return <DraftHost adapter={ports.drafts} identity=\"fictional-gallery:showcase:demo-editor\" available><Button onClick={()=>setRevision(value=>value+1)}>Seed fictional draft</Button><DraftRecoveryCenter application={{id:'showcase',name:'Showcase',pages:{items:{id:'items',title:'Items'}}}} adapter={ports.center} renderWorkflow={(_item,close)=><div><p>Fictional retained draft. Use the shared draft example to edit and restore values.</p><Button onClick={close}>Close</Button></div>}/></DraftHost>;}
