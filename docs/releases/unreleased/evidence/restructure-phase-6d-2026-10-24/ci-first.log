@pepbits-demo/showcase:test: export function DcpDemo(){const [values,setValues]=useState<Record<string,DcpValue>>({name:'Fictional item',amount:'125.50',date:'2026-10-23',rows:[{_id:'one',note:'Example section'}]});const fields=[field('name'),field('amount','DECIMAL',false),field('date','DATE',false),{...field('rows','COLLECTION'),children:[field('note')]}];const view:DcpRuntimeView={contractVersion:1,label:'Item fields',definitionVersion:1,checksum:'demo',sections:[{code:'details',label:'Details',fields}],values,violations:[],rowFields:{'rows[one]':[field('note')]}};const change=(code:string,value:unknown)=>setValues(current=>({...current,[code]:value} as Record<string,DcpValue>));return <div className=\"space-y-3\"><DcpRuntimeFields fields={fields.slice(0,3)} values={values} view={view} change={change}/><DcpSectionFields primaryCollection=\"rows\" fieldCodes={['note']} collectionCodes={[]} values={values} view={view} change={change}/><details><summary>Writable patch</summary><pre tabIndex={0}>{JSON.stringify(dcpWritablePatch(view,values),null,2)}</pre></details></div>;}
