@pepbits-demo/showcase:test: /** State choices are example data; the policy-bound density uses the real host path. */
@pepbits-demo/showcase:test: export function ControlStatesDemo(){const [state,setState]=useState('default'),[value,setValue]=useState('one'),[many,setMany]=useState<string[]>([]),[number,setNumber]=useState(10),[checked,setChecked]=useState(false),[quantity,setQuantity]=useState({quantity:'1',unit:'EA'}),density=usePreference('density');const disabled=state==='disabled'||state==='loading',readOnly=state==='read-only',blocked=disabled||readOnly,error=state==='invalid'?'Check this fictional value':undefined,options=[{value:'one',label:'Option one'},{value:'two',label:'Option two'}];return <div className=\"space-y-3\"><Select label=\"Control state\" value={state} onChange={event=>setState(event.target.value)} options={['default','disabled','invalid','loading','read-only'].map(value=>({value,label:value}))}/><p>Read-only choices are disabled when the native control has no read-only contract. Loading is shown only by controls supporting it. Use tenant locks in the playground for the policy-bound control below.</p><div className=\"grid gap-3 md:grid-cols-2\">
@pepbits-demo/showcase:test:  <Input label=\"State input\" value={value} onChange={event=>setValue(event.target.value)} disabled={disabled} readOnly={readOnly} error={error}/><Textarea label=\"State notes\" value={value} onChange={event=>setValue(event.target.value)} disabled={disabled} readOnly={readOnly} error={error}/>
@pepbits-demo/showcase:test:  <Select label=\"State select\" options={options} value={value} onChange={event=>{if(!blocked)setValue(event.target.value);}} disabled={blocked} error={error}/><SearchSelect label=\"State search choice\" options={options} value={value} onChange={next=>{if(!blocked)setValue(next);}} disabled={blocked} error={error}/><MultiSelect label=\"State multiple choices\" options={options} value={many} onChange={next=>{if(!blocked)setMany(next);}} disabled={blocked} error={error}/>
@pepbits-demo/showcase:test:  <Checkbox label=\"State checkbox\" checked={checked} disabled={blocked} aria-invalid={!!error} onChange={event=>setChecked(event.target.checked)}/><Radio label=\"State radio\" checked={checked} disabled={blocked} aria-invalid={!!error} onChange={()=>setChecked(true)}/><RadioGroup label=\"State radio group\" options={options} value={value} disabled={blocked} error={error} onChange={setValue}/><RangeField label=\"State numeric range\" value={number} min={0} max={100} disabled={blocked} error={error} onChange={value=>setNumber(value??0)}/><RangeInput label=\"State slider\" value={number} min={0} max={100} disabled={blocked} onChange={setNumber}/><Toggle label=\"State toggle\" checked={checked} disabled={blocked} onChange={setChecked}/>
@pepbits-demo/showcase:test:  {[DateInput,TimeInput,DateTimeInput,MonthInput,WeekInput].map((Control,index)=><Control key={index} label={['State date','State time','State date time','State month','State week'][index]} disabled={disabled} readOnly={readOnly} error={error}/>)}<DateRangeInput start={{label:'State start',disabled,readOnly,error}} end={{label:'State end',disabled,readOnly,error}}/>
@pepbits-demo/showcase:test:  <QuantityUnitField label=\"State quantity\" quantityLabel=\"Quantity\" unitLabel=\"Unit\" value={quantity} onChange={setQuantity} options={[{value:'EA',label:'Each'}]} disabled={disabled} readOnly={readOnly} loading={state==='loading'} error={error}/><ScannerInput label=\"State scanner\" disabled={blocked} onScan={async()=>true}/><FilePicker label=\"State file\" disabled={blocked} onFile={()=>{}}/><Button disabled={blocked} loading={state==='loading'}>State action</Button>
@pepbits-demo/showcase:test:  <Select label=\"Policy-bound density\" value={density.value} disabled={density.locked} options={(['compact','comfortable','spacious'] as const).filter(value=>!density.allowedValues||density.allowedValues.includes(value)).map(value=>({value,label:value}))} onChange={event=>density.update({density:event.target.value as 'compact'|'comfortable'|'spacious'})}/></div></div>;}
