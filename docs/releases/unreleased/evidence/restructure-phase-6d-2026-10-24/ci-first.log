@pepbits-demo/showcase:test:  if(path==='/worklists/search'){const query=String(body.safeFilters?.query??body.sensitiveFilters?.query??body.safeFilters?.q??body.sensitiveFilters?.q??'').toLowerCase();let shown=rows.filter(row=>row.name.toLowerCase().includes(query));if(body.sort){const {key,direction}=body.sort;shown=[...shown].sort((a,b)=>String(a[key as keyof typeof a]).localeCompare(String(b[key as keyof typeof b]),undefined,{numeric:true})*(direction==='desc'?-1:1));}const pageSize=body.pageSize??20,page=body.page??1;return Response.json({rows:shown.slice((page-1)*pageSize,page*pageSize),total:shown.length,page});}
@pepbits-demo/showcase:test:  if(path.startsWith('/layouts')){if(init?.method==='PUT')layouts[body.pageId]=body.layout;return Response.json({layouts});}
@pepbits-demo/showcase:test:  if(path.startsWith('/personal-views')){if(body.action==='create')personal=[...personal,{id:crypto.randomUUID(),label:body.label,layout:body.layout,version:1,isDefault:false}];if(body.action==='delete')personal=personal.filter(item=>item.id!==body.id);if(body.action==='rename'||body.action==='default')personal=personal.map(item=>item.id===body.id?{...item,label:body.label??item.label,isDefault:body.isDefault??item.isDefault,version:item.version+1}:item);return Response.json({views:personal});}
@pepbits-demo/showcase:test:  if(path==='/worklists/archive'){rows=rows.filter(row=>!(body.ids??[]).includes(row.id));return Response.json({results:(body.ids??[]).map((id:string)=>({id,ok:true}))});}
