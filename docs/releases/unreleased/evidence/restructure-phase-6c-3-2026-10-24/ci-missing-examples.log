@pepbits-demo/showcase:test:  const navigation=useNavigation(),workspace=useWorkspace(),split=useSplit(),{product,toast}=useShell(),{preferences}=usePreferences();
@pepbits-demo/showcase:test:  const report=(result:{ok:boolean;reason?:string})=>{if(!result.ok)toast({title:result.reason??'Unavailable',type:'warning'});};
@pepbits-demo/showcase:test:  return <div className=\"space-y-3\"><p>The tabs and canvas above belong to the full shell. Open Foundations beside this page, focus either pane, then exit split.</p><div className=\"flex flex-wrap gap-2\">
