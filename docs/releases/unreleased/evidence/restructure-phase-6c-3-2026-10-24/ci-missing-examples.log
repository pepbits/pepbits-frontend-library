@pepbits-demo/showcase:test:   else {const job=library.jobs.find(j=>j.id===input.jobId);if(!job)throw new Error('Unknown fictional job');if(input.action==='print')job.attempts.push({id:input.operationId!,at:new Date().toISOString(),reason:input.reason??'',status:'requested'});result=job;}
