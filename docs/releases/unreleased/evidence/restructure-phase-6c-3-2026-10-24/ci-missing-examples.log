@pepbits-demo/showcase:test:  preview:async(productId,pageId,rows,id)=>{current=JSON.stringify([productId,id]);const job:ImportJob={id,productId,pageId,confirmed:false,createdAt:new Date().toISOString(),rows:rows.map((values,index)=>({row:index+1,values,errors:values.code&&values.name?{} as Record<string,string>:{name:'Code and name are required'},status:values.code&&values.name?'pending':'invalid'}))};return (await records.save(current,job,0,0,id)).record!.values;},
