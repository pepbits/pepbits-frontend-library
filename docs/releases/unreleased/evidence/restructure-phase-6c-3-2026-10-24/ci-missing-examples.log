@pepbits-demo/showcase:test: export function createDemoDevices():IntegrationAdapter{
@pepbits-demo/showcase:test:  const library:IntegrationLibrary={devices:[{id:'printer',title:'Fictional printer',transport:'native',capabilities:['label']}],records:[{id:'item-a',code:'ITEM-A',title:'Fictional item',context:'items'}],rules:[],jobs:[],stationId:'example-station',defaultDevice:'printer',policy:{version:1,lockedDevice:'',automatic:false,maxCopies:10},canManage:false};
@pepbits-demo/showcase:test:  const operations=new Map<string,unknown>();
@pepbits-demo/showcase:test:  const adapter:IntegrationAdapter={library:async()=>structuredClone(library),async command<T>(input:IntegrationCommand):Promise<T>{
@pepbits-demo/showcase:test:   if(input.operationId&&operations.has(input.operationId))return structuredClone(operations.get(input.operationId)) as T;
@pepbits-demo/showcase:test:   let result:unknown=library;
@pepbits-demo/showcase:test:   if(input.action==='enqueue'){const job:IntegrationJob={id:input.operationId!,owner:'demo',stationId:input.stationId,deviceId:input.deviceId!,capability:input.capability!,recordId:input.recordId!,eventId:'',status:'queued',copies:input.copies??1,createdAt:new Date().toISOString(),title:'Fictional item',lines:['ITEM-A'],attempts:0};library.jobs.push(job);result=job;}
@pepbits-demo/showcase:test:   else if(input.action==='lookup')result=library.records.find(r=>r.code===input.code&&r.context===input.context);
@pepbits-demo/showcase:test:   else if(input.action==='dispatch'||input.action==='cancel'){const job=library.jobs.find(j=>j.id===input.jobId)!;if(input.action==='cancel')job.status='cancelled';result=job;}
@pepbits-demo/showcase:test:   else if(input.action==='preference')library.defaultDevice=input.deviceId!;
@pepbits-demo/showcase:test:   if(input.operationId)operations.set(input.operationId,structuredClone(result));return structuredClone(result) as T;
@pepbits-demo/showcase:test:  }};
@pepbits-demo/showcase:test:  return withDeviceConnector(adapter,{connector:createDeviceConnector(async(_method,payload)=>({jobId:(payload as {jobId:string}).jobId,state:'accepted'})),ticket:async job=>({jobId:job.id,deviceId:job.deviceId,contentReference:'fictional-content',expiresAt:new Date(Date.now()+120000).toISOString()}),acknowledge:async(job,result)=>{const next={...job,status:result.state,attempts:job.attempts+1};library.jobs=library.jobs.map(j=>j.id===next.id?next:j);return next;}});
@pepbits-demo/showcase:test: }
