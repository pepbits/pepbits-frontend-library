@pepbits-demo/showcase:test:   view={...view,initial:record.definition,record,records:[record]};
@pepbits-demo/showcase:test:   if(command.operationId)operations.set(command.operationId,structuredClone(view));return structuredClone(view);
@pepbits-demo/showcase:test:  }};
@pepbits-demo/showcase:test: }
