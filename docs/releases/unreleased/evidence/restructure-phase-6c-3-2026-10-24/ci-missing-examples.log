@pepbits-demo/showcase:test:   <label htmlFor={id+'-time'}>{t('Time')}</label><SourceTimeInput id={id+'-time'} className={inputClass} value={time} onChange={event=>setTime(event.target.value)}/>
@pepbits-demo/showcase:test:   <label htmlFor={id+'-date-time'}>{t('Date and time')}</label><SourceDateTimeInput id={id+'-date-time'} className={inputClass} value={dateTime} onChange={event=>setDateTime(event.target.value)}/>
@pepbits-demo/showcase:test:   <label htmlFor={id+'-notes'}>{t('Notes')}</label><SourceTextarea id={id+'-notes'} className={inputClass} value={notes} onChange={event=>setNotes(event.target.value)}/>
@pepbits-demo/showcase:test:   <AsyncLookup label=\"Search\" loadOptions={loadOptions} getKey={record=>record.id} renderOption={record=>record.name} onPick={record=>setSelected(record.name)}/>
@pepbits-demo/showcase:test:   <SourceButton type=\"submit\" className=\"rounded-[var(--radius)] border border-[var(--border)] px-3 py-2\">Save</SourceButton>
@pepbits-demo/showcase:test:   <p role=\"status\">{selected}</p>
@pepbits-demo/showcase:test:  </form>;
@pepbits-demo/showcase:test: }
