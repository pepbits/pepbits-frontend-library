{
  "name": "pepbits-frontend-library",
  "private": true,
  "version": "0.0.0",
  "description": "PepBits frontend library: layered @pepbits/* packages and the demo apps built from them. See docs/architecture/PACKAGE-RESTRUCTURE-PLAN.md.",
  "workspaces": [
    "packages/*",
    "demo-apps/*",
    "tooling/*"
  ],
  "packageManager": "npm@11.13.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:boundaries": "node tooling/scripts/check-boundaries.mjs",
    "test:tooling": "node --test tooling/scripts/*.test.mjs",
    "ci": "npm run check:boundaries && npm run test:tooling && NEXT_PUBLIC_API_URL=/api NEXT_PUBLIC_SETTLE_API_URL=/settle-api NEXT_PUBLIC_CAREGRID_API_URL=/caregrid-api VITE_API_URL=/api turbo run typecheck test build --force --concurrency=1",
    "release:version": "changeset version",
    "release:build": "turbo run build --filter='./packages/*' --concurrency=3",
    "release:pack": "npm run release:build && node tooling/scripts/release-pack.mjs",
    "release:publish": "node tooling/scripts/release-publish.mjs",
    "docs:check": "node docs/tools/check-docs.mjs",
    "test:api": "npm test --prefix mock-api",
    "test:clinical-api": "npm run test:clinical --prefix mock-api",
    "build:api": "npm run build --prefix mock-api",
    "test:deployment": "node --test tooling/deployment/*.test.mjs",
    "stamp:builds": "node tooling/scripts/stamp-demo-builds.mjs",
    "package:test-site": "node tooling/scripts/package-test-site.mjs",
    "verify:test-site": "node tooling/scripts/verify-test-site.mjs",
    "ci:gates": "bash tooling/scripts/ci-gates.sh"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@types/node": "^22.0.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.7",
    "@changesets/cli": "^2.30.0"
  },
  "engines": {
    "node": ">=22"
  }
}
