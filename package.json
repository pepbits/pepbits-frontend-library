{
  "name": "pepbits-frontend-library",
  "private": true,
  "version": "0.0.0",
  "description": "PepBits frontend library: layered @pepbits/* packages and the demo apps built from them. See docs/architecture/PACKAGE-RESTRUCTURE-PLAN.md.",
  "workspaces": [
    "packages/*",
    "demo-apps/*",
    "tooling/*"
  ],
  "packageManager": "npm@11.13.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:boundaries": "node tooling/scripts/check-boundaries.mjs",
    "test:tooling": "node --test tooling/scripts/*.test.mjs",
    "ci": "npm run check:boundaries && npm run test:tooling && turbo run typecheck test build --force"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@types/node": "^22.0.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
