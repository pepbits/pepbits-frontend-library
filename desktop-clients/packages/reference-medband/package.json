{
  "name": "@pepbits/reference-medband",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MedBand patient access reference module (today's desk, patient search and wristband record, registration, encounters, admission queues, episodes and cases) rendered through the authenticated host.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./medband-copy.json": "./medband-copy.json"
  },
  "dependencies": {
    "@pepbits/erp-config": "*",
    "@pepbits/ops-ui": "*",
    "@pepbits/reference-host": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "scripts": {
    "generate:styles": "node ../../scripts/medband/styles.mjs",
    "check:styles": "node ../../scripts/medband/styles.mjs --check",
    "generate:copy": "node ../../scripts/medband/copy.mjs",
    "check:copy": "node ../../scripts/medband/copy.mjs --check"
  },
  "pepbits": {
    "styleScope": ".reference-medband"
  }
}
