{
  "name": "@pepbits/reference-rcm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RCM (Allyvora revenue cycle workspace) reference module: billing home, aging, reports, approvals inbox and the 36 registry worklists rendered through the authenticated host.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./rcm-copy.json": "./rcm-copy.json"
  },
  "dependencies": {
    "@pepbits/erp-config": "*",
    "@pepbits/ops-ui": "*",
    "@pepbits/reference-host": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "scripts": {
    "generate:styles": "node ../../scripts/rcm/styles.mjs",
    "check:styles": "node ../../scripts/rcm/styles.mjs --check",
    "generate:copy": "node ../../scripts/rcm/copy.mjs",
    "check:copy": "node ../../scripts/rcm/copy.mjs --check"
  },
  "pepbits": {
    "styleScope": ".reference-rcm"
  }
}
