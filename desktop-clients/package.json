{
  "name": "nexora-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Nexora Enterprise ERP \u2014 web and desktop shells over shared @pepbits packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "ci": "npm run typecheck && npm test && npm run test:api && npm run test:e2e-registry && npm run test:deployment && npm run build && npm run verify",
    "deploy": "node scripts/deploy.mjs",
    "deploy:prepare": "node scripts/deploy.mjs --prepare-only",
    "desktop": "npm run tauri -w desktop -- dev",
    "dev": "turbo run dev",
    "dev:all": "node ../dummy-api/server.mjs & API=$!; trap 'kill $API 2>/dev/null' EXIT INT TERM; turbo run dev",
    "dev:api": "node ../dummy-api/server.mjs",
    "dev:desktop": "npm run dev -w desktop",
    "dev:stack": "node ../dummy-api/server.mjs & API=$!; trap 'kill $API 2>/dev/null' EXIT INT TERM; npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "e2e": "node e2e/run.mjs",
    "e2e:native": "node e2e/tauri-native.mjs",
    "e2e:phi": "node e2e/phi-safety.e2e.mjs",
    "e2e:workspace": "node e2e/workspace.e2e.mjs",
    "lint": "turbo run lint",
    "stop": "for p in 3100 3101 3200; do lsof -ti tcp:$p | xargs kill 2>/dev/null; done; true",
    "test": "vitest run",
    "test:deployment": "node --test scripts/deployment/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "verify": "npm run -s verify:parity && npm run -s verify:ai-gates && npm run -s verify:ai-modes && npm run -s verify:ai-context && npm run -s verify:ai-limits && npm run -s verify:em-levels && npm run -s verify:filter-safety && npm run -s verify:ai-egress && npm run -s verify:export-safety && npm run -s verify:contrast && npm run -s verify:form-controls && npm run -s verify:shared-components && npm run -s verify:deployable && npm run -s verify:ai-hardening && npm run -s verify:localization && npm run -s verify:e2e-registry && npm run -s verify:bundle && npm run -s verify:documentation && npm run -s verify:library && npm run -s verify:templates && npm run -s verify:library-preferences",
    "verify:ai-context": "node scripts/verify-ai-context.mjs",
    "verify:ai-credential": "node scripts/verify-ai-credential.mjs",
    "verify:ai-egress": "node scripts/verify-ai-egress.mjs",
    "verify:ai-gates": "node scripts/verify-ai-gates.mjs",
    "verify:ai-hardening": "node scripts/verify-ai-hardening.mjs",
    "verify:ai-limits": "node scripts/check-ai-limits-isolated.mjs",
    "verify:ai-modes": "node scripts/verify-ai-modes.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:deployable": "node scripts/verify-deployable.mjs",
    "verify:em-levels": "node scripts/verify-em-levels.mjs",
    "verify:export-safety": "node scripts/verify-export-safety.mjs",
    "verify:filter-safety": "node scripts/verify-filter-safety.mjs",
    "verify:form-controls": "node scripts/verify-form-controls.mjs",
    "verify:parity": "node scripts/verify-parity.mjs",
    "e2e:records": "node e2e/records.mjs",
    "test:records-api": "node --test ../dummy-api/record-store.test.mjs ../dummy-api/records-http.test.mjs",
    "e2e:workflows": "node e2e/workflows.mjs",
    "test:workflows-api": "node --test ../dummy-api/workspace-store.test.mjs ../dummy-api/records-http.test.mjs",
    "product:create": "node scripts/products/create-product.mjs",
    "test:products": "node --test scripts/products/*.test.mjs",
    "e2e:panels": "node e2e/record-panels.mjs",
    "test:panels-api": "node --test ../dummy-api/record-panels-store.test.mjs ../dummy-api/records-http.test.mjs",
    "e2e:imports": "node e2e/imports.mjs",
    "test:imports-api": "node --test ../dummy-api/import-store.test.mjs ../dummy-api/records-http.test.mjs",
    "e2e:approvals": "node e2e/approvals.mjs",
    "test:approvals-api": "node --test ../dummy-api/approval-store.test.mjs ../dummy-api/records-http.test.mjs",
    "verify:localization": "node scripts/localization/check-copy.mjs && node scripts/localization/check-api-copy.mjs && node scripts/localization/sync-fallbacks.mjs --check",
    "localization:sync": "node scripts/localization/sync-fallbacks.mjs",
    "e2e:localization": "node e2e/localization.mjs && node e2e/page-body-localization.mjs && node e2e/localization-formatting.mjs",
    "e2e:backend-messages": "node e2e/backend-messages.mjs",
    "e2e:localized-exports": "node e2e/localization-exports.mjs",
    "e2e:native-localization": "node e2e/native-localization.mjs",
    "e2e:components": "node e2e/shared-components.mjs",
    "verify:shared-components": "node scripts/verify-shared-components.mjs",
    "test:api": "node --test --test-concurrency=4 ../dummy-api/*.test.mjs && npm run test:clinical-api",
    "test:e2e-registry": "node --test e2e/tests/*.test.mjs",
    "e2e:features": "node e2e/run.mjs features",
    "e2e:navigation": "node e2e/run.mjs navigation",
    "e2e:product": "node e2e/run.mjs product",
    "e2e:native:all": "node e2e/run.mjs native",
    "verify:e2e-registry": "node e2e/run.mjs --check",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:documentation": "node scripts/verify-documentation.mjs && node ../docs/tools/documentation-lifecycle.mjs check",
    "library:sync": "node scripts/library/generate-examples.mjs",
    "verify:library": "node scripts/library/generate-examples.mjs --check",
    "templates:sync": "node scripts/templates/generate-example.ts",
    "verify:templates": "node scripts/templates/generate-example.ts --check",
    "test:clinical-api": "tsc -p ../dummy-api/tsconfig.clinical.json && node --test ../dummy-api/clinical-template-store.test.ts ../dummy-api/clinical-template-csv.test.ts ../dummy-api/clinic-billing-store.test.ts ../dummy-api/clinical-triage-store.test.ts ../dummy-api/clinical-consultation-store.test.ts ../dummy-api/comprehensive-consultation-store.test.ts ../dummy-api/op-registration-store.test.ts",
    "verify:library-preferences": "node scripts/verify-library-preferences.mjs",
    "test:labels-api": "node --test ../dummy-api/label-printing-store.test.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "npm@11.13.0"
}
