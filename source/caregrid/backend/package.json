{
  "name": "caregrid-api",
  "version": "1.0.0",
  "private": true,
  "description": "CareGrid scheduling API - Express + SQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && node -e \"require('fs').cpSync('src/db','dist/db',{recursive:true,filter:(s)=>!s.endsWith('.ts')})\"",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "11.5.0",
    "cors": "2.8.5",
    "express": "4.21.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
