{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../diagnostics-source/lis2/src/*"
      ],
      "*": [
        "node_modules/*"
      ]
    },
    "types": [
      "node"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": false
  },
  "include": [
    "../diagnostics-source/lis2/src/**/*.ts"
  ],
  "exclude": [
    "../diagnostics-source/lis2/src/main.ts"
  ]
}
