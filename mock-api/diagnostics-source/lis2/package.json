{
  "name": "lis-backend",
  "version": "1.0.0",
  "description": "Laboratory Information System - NestJS API (SQLite)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "start:prod": "npm run build && node dist/main.js",
    "reset-db": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "simulate": "node tools/simulate-lab-day.mjs",
    "e2e": "node tools/e2e-internal.mjs && node tools/e2e-integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "better-sqlite3": "12.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}